# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP Configuration for Contact Form Enquiries:
# Host (e.g. smtp.gmail.com, mail.yourdomain.com, or smtp.hostinger.com)
SMTP_HOST=smtp.gmail.com
# Port (typically 465 for SSL or 587 for TLS)
SMTP_PORT=465
# Secure (true for port 465, false for port 587)
SMTP_SECURE=true
# Sender / SMTP Account Username or Email (e.g. umeshkotwal658@gmail.com)
SMTP_USER=umeshkotwal658@gmail.com
# SMTP Password or Gmail App Password (16 characters from Google App Passwords)
SMTP_PASS=
# Recipient Email for incoming inquiries (defaults to umeshkotwal658@gmail.com)
CONTACT_RECIPIENT_EMAIL=umeshkotwal658@gmail.com
